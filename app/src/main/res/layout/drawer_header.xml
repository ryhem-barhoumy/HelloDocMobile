<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="204dp"
    android:background="@drawable/bg_drawer_header"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="22dp">

    <ImageView
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:background="@drawable/bg_white_round"
        android:contentDescription="@string/app_name"
        android:padding="10dp"
        android:src="@drawable/medical_symbol" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/drawer_brand"
        android:textColor="@color/hd_white"
        android:textSize="24sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/drawer_subtitle"
        android:textColor="#E7FFFA"
        android:textSize="13sp" />
</LinearLayout>
